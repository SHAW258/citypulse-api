# Local development only. Never use the root/root credentials or this secret in production.
ENVIRONMENT=development
DEBUG=true
APP_NAME=CityPulse API
API_V1_PREFIX=/api/v1

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=citypulse
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Create a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array; only explicitly trusted browser origins belong here.
CORS_ORIGINS=["http://localhost:3000","http://10.0.2.2:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
FORCE_HTTPS=false

