# Local development only. Never use the root/root credentials or this secret in production.
ENVIRONMENT=development
DEBUG=true
APP_NAME=CityPulse API
API_V1_PREFIX=/api/v1

# Database configuration (Option A: MySQL parameters OR Option B: Supabase / PostgreSQL DATABASE_URL)
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=citypulse
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Create a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8080","http://127.0.0.1:8080","http://10.0.2.2:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
FORCE_HTTPS=false

